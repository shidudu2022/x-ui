{
  "name": "@shidudu2022/x-ui",
  "version": "0.1.0",
  "description": "React design system for ops / admin consoles",
  "license": "MIT",
  "author": "shidudu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shidudu2022/x-ui.git"
  },
  "homepage": "https://shidudu2022.github.io/x-ui/",
  "bugs": {
    "url": "https://github.com/shidudu2022/x-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "design-system",
    "admin",
    "dashboard"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:pages": "tsc -b && VITE_BASE=/x-ui/ vite build && node scripts/spa-github-pages.mjs",
    "prepublishOnly": "npm run build:lib",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:pages": "npm run build:pages && vite preview --base /x-ui/"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "react-router-dom": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "recharts": "^3.10.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^4.5.4"
  }
}
